---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title,
  description = '169 curated Java DSA solutions with patterns, complexity analysis, and revision tools. Built for interview preparation.',
  fullWidth = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://sandypkumr.github.io');
const fullTitle = title === 'DSA Java Portal' ? title : `${title} · DSA Java`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="java, dsa, leetcode, algorithms, data structures, interview preparation, coding interview" />
    <meta name="author" content="Sandeep Kumar Pabba" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <!-- Dark is default; only add .light if user saved light or system prefers light -->
    <script is:inline>
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('theme');
        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (stored === 'light' || (!stored && prefersLight)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body>
    <slot name="header" />
    <main class:list={['page-main', { 'full-width': fullWidth }]} data-pagefind-body>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style>
  .page-main {
    flex: 1;
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 2rem 4rem;
  }
  .page-main.full-width {
    max-width: 1200px;
    padding: 0 0 4rem;
  }
  @media (max-width: 768px) {
    .page-main { padding: 1.5rem 1rem 3rem; }
  }
</style>
