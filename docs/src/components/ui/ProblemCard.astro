---
import Badge from './Badge.astro';

export interface Props {
  title: string;
  difficulty: 'Easy' | 'Medium' | 'Hard';
  topic: string;
  slug: string;          // e.g. "array/two-sum"
  patterns?: string[];
  timeComplexity?: string;
  spaceComplexity?: string;
  leetcodeUrl?: string;
  githubUrl?: string;
  hasProblemStatement?: boolean;
}

const {
  title, difficulty, topic, slug,
  patterns = [], timeComplexity = '', spaceComplexity = '',
  leetcodeUrl = '', githubUrl = '',
  hasProblemStatement = false,
} = Astro.props;

const base       = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailHref = `${base}/problems/${slug}`;
const diffVar    = difficulty.toLowerCase() as 'easy' | 'medium' | 'hard';
---

<article class="problem-card">
  <div class="card-top">
    <a href={detailHref} class="card-title">{title}</a>
    <Badge variant={diffVar} label={difficulty} />
  </div>

  {(timeComplexity || spaceComplexity) && (
    <div class="card-complexity">
      {timeComplexity  && <span class="chip">T: {timeComplexity}</span>}
      {spaceComplexity && <span class="chip">S: {spaceComplexity}</span>}
    </div>
  )}

  {patterns.length > 0 && (
    <div class="card-patterns">
      {patterns.slice(0, 3).map(p => (
        <span class="pattern-tag">{p}</span>
      ))}
      {patterns.length > 3 && <span class="pattern-more">+{patterns.length - 3}</span>}
    </div>
  )}

  <div class="card-footer">
    <div class="card-links">
      {leetcodeUrl && (
        <a href={leetcodeUrl} target="_blank" rel="noopener noreferrer" class="ext-link lc-link" title="Open on LeetCode">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/></svg>
          LeetCode
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link gh-link" title="View Java source">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          Java
        </a>
      )}
    </div>
    <a href={detailHref} class="view-link">View solution →</a>
  </div>
</article>

<style>
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .problem-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-bg);
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.35;
    flex: 1;
    min-width: 0;
  }
  .card-title:hover { color: var(--color-accent); }

  .card-complexity {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
  .chip {
    font-size: 0.6875rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-text-2);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.15rem 0.4rem;
  }

  .card-patterns {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .pattern-tag {
    font-size: 0.6875rem;
    color: var(--color-accent);
    background: var(--color-accent-bg);
    border-radius: 9999px;
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }
  .pattern-more {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.25rem;
  }
  .card-links {
    display: flex;
    gap: 0.375rem;
  }
  .ext-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.1s ease, background 0.1s ease;
  }
  .lc-link { color: #f89f1b; }
  .gh-link { color: var(--color-text-2); }
  .ext-link:hover { background: var(--color-sidebar); border-color: var(--color-accent); }

  .view-link {
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .view-link:hover { text-decoration: underline; }
</style>
