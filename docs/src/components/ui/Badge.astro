---
export interface Props {
  variant: 'easy' | 'medium' | 'hard' | 'topic' | 'pattern' | 'default';
  label: string;
  size?: 'sm' | 'md';
}
const { variant, label, size = 'sm' } = Astro.props;
---
<span class={`badge badge-${variant} badge-${size}`}>{label}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    font-weight: 500;
    white-space: nowrap;
    line-height: 1;
  }
  .badge-sm { font-size: 0.6875rem; padding: 0.2rem 0.6rem; }
  .badge-md { font-size: 0.8125rem; padding: 0.3rem 0.75rem; }

  .badge-easy    { color: var(--color-easy);   background: var(--color-easy-bg);   }
  .badge-medium  { color: var(--color-medium); background: var(--color-medium-bg); }
  .badge-hard    { color: var(--color-hard);   background: var(--color-hard-bg);   }
  .badge-topic   { color: var(--color-accent); background: var(--color-accent-bg); }
  .badge-pattern {
    color: var(--color-text-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .badge-default {
    color: var(--color-text-2);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
</style>
