---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="Page Not Found">
  <Header  slot="header"  />

  <div class="not-found">
    <div class="nf-code">404</div>
    <h1 class="nf-title">Page not found</h1>
    <p class="nf-text">
      This page doesn't exist yet — it may be coming in a future phase,
      or the URL may be incorrect.
    </p>
    <a href={import.meta.env.BASE_URL} class="nf-back">← Back to home</a>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 55vh;
    text-align: center;
    gap: 0.875rem;
  }
  .nf-code {
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-border);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .nf-title { font-size: 1.5rem; font-weight: 600; color: var(--color-text); margin: 0; }
  .nf-text  { font-size: 0.9375rem; color: var(--color-text-2); line-height: 1.7; max-width: 380px; margin: 0; }
  .nf-back  { margin-top: 0.5rem; font-size: 0.875rem; color: var(--color-accent); text-decoration: none; font-weight: 500; }
  .nf-back:hover { text-decoration: underline; }
</style>
