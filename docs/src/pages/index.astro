---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const topics = [
  { slug: 'array',               label: 'Array',               count: 24, icon: '📊', desc: 'Sliding window, two pointers, prefix sums, intervals',  easy: 7,  med: 15, hard: 2 },
  { slug: 'graph',               label: 'Graph',               count: 21, icon: '🕸️', desc: 'BFS, DFS, topological sort, union-find, shortest path',  easy: 1,  med: 15, hard: 5 },
  { slug: 'binary_tree',         label: 'Binary Tree',         count: 18, icon: '🌲', desc: 'Traversals, path sums, LCA, serialization',              easy: 7,  med:  9, hard: 2 },
  { slug: 'stack',               label: 'Stack',               count: 14, icon: '📚', desc: 'Monotonic stack, calculator, parentheses matching',      easy: 3,  med:  6, hard: 5 },
  { slug: 'string',              label: 'String',              count: 14, icon: '🔤', desc: 'Sliding window, palindrome, anagram, encoding',          easy: 5,  med:  7, hard: 2 },
  { slug: 'linked_list',         label: 'Linked List',         count: 14, icon: '🔗', desc: 'Two pointers, reversal, merge, LRU Cache',               easy: 6,  med:  7, hard: 1 },
  { slug: 'dynamic_programming', label: 'Dynamic Programming', count: 12, icon: '🧮', desc: '1D/2D DP, knapsack, LIS, coin change, word break',       easy: 3,  med:  7, hard: 2 },
  { slug: 'binary_search',       label: 'Binary Search',       count:  8, icon: '🔍', desc: 'Rotated arrays, boundary search, DP + binary search',   easy: 1,  med:  5, hard: 2 },
  { slug: 'heap',                label: 'Heap',                count:  8, icon: '⛰️', desc: 'PriorityQueue, top-K, median stream, merge K lists',     easy: 0,  med:  5, hard: 3 },
  { slug: 'binary',              label: 'Binary / Bit Ops',    count:  7, icon: '⚙️', desc: 'XOR tricks, counting bits, missing number',             easy: 4,  med:  3, hard: 0 },
  { slug: 'recursion',           label: 'Recursion',           count:  6, icon: '🔄', desc: 'Backtracking, permutations, combinations, N-Queens',    easy: 1,  med:  4, hard: 1 },
  { slug: 'binary_search_tree',  label: 'BST',                 count:  5, icon: '🌳', desc: 'In-order, validation, kth smallest, successor',         easy: 1,  med:  3, hard: 1 },
  { slug: 'math',                label: 'Math',                count:  5, icon: '➗', desc: 'Number theory, power, random weighted sampling',        easy: 2,  med:  2, hard: 1 },
  { slug: 'matrix',              label: 'Matrix',              count:  5, icon: '🟦', desc: 'Spiral, rotate, Sudoku, island problems',               easy: 0,  med:  4, hard: 1 },
  { slug: 'trie',                label: 'Trie',                count:  4, icon: '🌐', desc: 'Prefix tree, word search, in-memory file system',       easy: 0,  med:  3, hard: 1 },
  { slug: 'hash_table',          label: 'Hash Table',          count:  3, icon: '#️⃣', desc: 'Insert-delete-getRandom O(1), ransom note',             easy: 1,  med:  2, hard: 0 },
  { slug: 'queue',               label: 'Queue',               count:  1, icon: '📥', desc: 'Design hit counter, circular buffer',                   easy: 0,  med:  1, hard: 0 },
];
---

<BaseLayout title="DSA Java Portal" fullWidth={true}>
  <Header slot="header" />

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-badge">☕ Java &nbsp;·&nbsp; Interview Ready</div>
    <h1 class="hero-title">
      Master DSA in Java.<br/>
      <span class="hero-accent">One problem at a time.</span>
    </h1>
    <p class="hero-sub">
      169 hand-crafted Java solutions, organized by topic and pattern.
      Built for fast revision, pattern recognition, and interview confidence.
    </p>
    <div class="hero-ctas">
      <a href={`${base}/topics/array`} class="cta-primary">Browse Topics</a>
      <a href={`${base}/search`} class="cta-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Search Problems
      </a>
    </div>
    <div class="stats-bar">
      <div class="stat-item"><span class="stat-val">169</span><span class="stat-lbl">PROBLEMS</span></div>
      <div class="stat-sep"></div>
      <div class="stat-item"><span class="stat-val">17</span><span class="stat-lbl">TOPICS</span></div>
      <div class="stat-sep"></div>
      <div class="stat-item"><span class="stat-val stat-easy">41</span><span class="stat-lbl">EASY</span></div>
      <div class="stat-sep"></div>
      <div class="stat-item"><span class="stat-val stat-med">102</span><span class="stat-lbl">MEDIUM</span></div>
      <div class="stat-sep"></div>
      <div class="stat-item"><span class="stat-val stat-hard">26</span><span class="stat-lbl">HARD</span></div>
    </div>
  </section>

  <!-- ── Browse by Topic ───────────────────────────────────────────── -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Browse by Topic</h2>
      <a href={`${base}/topics/array`} class="view-all">View all →</a>
    </div>
    <div class="topics-grid">
      {topics.map(t => (
        <a href={`${base}/topics/${t.slug}`} class="topic-card">
          <div class="topic-card-top">
            <span class="topic-icon">{t.icon}</span>
            <span class="topic-count">{t.count}</span>
          </div>
          <div class="topic-name">{t.label}</div>
          <div class="topic-desc">{t.desc}</div>
          <div class="topic-diff">
            {t.easy  > 0 && <span class="d-easy">{t.easy}</span>}
            {t.med   > 0 && <span class="d-med">{t.med}</span>}
            {t.hard  > 0 && <span class="d-hard">{t.hard}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Patterns CTA ──────────────────────────────────────────────── -->
  <section class="patterns-cta">
    <div class="cta-content">
      <h2>Recognize Patterns, Not Just Problems</h2>
      <p>Every problem is tagged with algorithmic patterns — sliding window, two pointers, BFS/DFS, union-find, and more. Learn the pattern, solve any variant.</p>
      <a href={`${base}/patterns`} class="cta-primary">Explore Patterns</a>
    </div>
    <div class="pattern-pills">
      {['DFS','BFS','Dynamic Programming','Two Pointers','Hash Map','Binary Search','Backtracking','Greedy','Prefix Sum','Sliding Window','Fast and Slow Pointers','Min Heap','Topological Sort','Trie'].map(p => (
        <span class="p-pill">{p}</span>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 4rem 2rem 3.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-h);
    background: var(--color-accent-bg);
    padding: 0.3rem 0.875rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }
  .hero-accent { color: var(--color-accent-h); }
  .hero-sub {
    font-size: 1.0625rem;
    color: var(--color-text-2);
    max-width: 520px;
    line-height: 1.7;
    margin: 0 0 2rem;
  }
  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .cta-primary:hover { background: var(--color-accent-h); transform: translateY(-1px); }
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: transparent;
    color: var(--color-text-2);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cta-ghost:hover { border-color: var(--color-accent); color: var(--color-text); }

  /* ── Stats bar ── */
  .stats-bar {
    display: inline-flex;
    align-items: center;
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 0.875rem 1.5rem;
    flex-wrap: wrap;
    row-gap: 0.75rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.25rem;
  }
  .stat-sep {
    width: 1px;
    height: 2rem;
    background: var(--color-border);
  }
  .stat-val {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }
  .stat-lbl {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }
  .stat-easy  { color: var(--color-easy); }
  .stat-med   { color: var(--color-medium); }
  .stat-hard  { color: var(--color-hard); }

  /* ── Section ── */
  .section {
    padding: 0 2rem;
    max-width: 1200px;
    margin: 0 auto 3.5rem;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .view-all {
    font-size: 0.8125rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .view-all:hover { color: var(--color-accent-h); }

  /* ── Topic cards ── */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.875rem;
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.125rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
  }
  .topic-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(99,102,241,0.12);
  }
  .topic-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.375rem;
  }
  .topic-icon  { font-size: 1.25rem; }
  .topic-count { font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted); }
  .topic-name  { font-size: 0.9375rem; font-weight: 600; color: var(--color-text); }
  .topic-desc  { font-size: 0.775rem; color: var(--color-text-muted); line-height: 1.5; flex: 1; }
  .topic-diff  {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }
  .d-easy  { font-size: 0.8rem; font-weight: 700; color: var(--color-easy); }
  .d-med   { font-size: 0.8rem; font-weight: 700; color: var(--color-medium); }
  .d-hard  { font-size: 0.8rem; font-weight: 700; color: var(--color-hard); }

  /* ── Patterns CTA ── */
  .patterns-cta {
    display: flex;
    align-items: center;
    gap: 3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2.5rem 2.5rem;
    margin: 0 2rem 3rem;
    max-width: 1156px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-content {
    flex: 1;
    min-width: 0;
  }
  .cta-content h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .cta-content p {
    font-size: 0.9rem;
    color: var(--color-text-2);
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 380px;
  }
  .pattern-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }
  .p-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent-h);
    background: var(--color-accent-bg);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  @media (max-width: 900px) {
    .patterns-cta { flex-direction: column; gap: 1.5rem; }
    .cta-content p { max-width: none; }
  }
  @media (max-width: 640px) {
    .hero    { padding: 2.5rem 1rem 2.5rem; }
    .section { padding: 0 1rem; }
    .patterns-cta { padding: 1.5rem; margin: 0 1rem 2rem; }
    .topics-grid  { grid-template-columns: 1fr 1fr; }
    .stats-bar    { padding: 0.75rem 0.75rem; }
    .stat-item    { padding: 0 0.75rem; }
    .stat-sep     { display: none; }
  }
</style>
