---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Badge from '../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const problems = await getCollection('problems');
  return problems.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const base       = import.meta.env.BASE_URL.replace(/\/$/, '');
const topicLabel = d.topic.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const diffVar    = d.difficulty.toLowerCase() as 'easy' | 'medium' | 'hard';

const TOPIC_ICONS: Record<string, string> = {
  array: '📊', binary: '⚙️', binary_search: '🔍', binary_search_tree: '🌳',
  binary_tree: '🌲', dynamic_programming: '🧮', graph: '🕸️', hash_table: '#️⃣',
  heap: '⛰️', linked_list: '🔗', math: '➗', matrix: '🟦',
  queue: '📥', recursion: '🔄', stack: '📚', string: '🔤', trie: '🌐',
};
const topicIcon = TOPIC_ICONS[d.topic] ?? '📌';
---

<BaseLayout title={d.title} description={`${d.difficulty} ${topicLabel} problem — Java solution with complexity analysis and pattern breakdown.`}>
  <Sidebar slot="sidebar" />
  <Header  slot="header"  />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}/`}>Home</a>
    <span aria-hidden="true">›</span>
    <a href={`${base}/topics/${d.topic}`}>{topicIcon} {topicLabel}</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{d.title}</span>
  </nav>

  <!-- Problem header -->
  <header class="problem-header">
    <div class="header-top">
      <h1 class="problem-title">{d.title}</h1>
      <Badge variant={diffVar} label={d.difficulty} size="md" />
    </div>

    <!-- Quick links -->
    <div class="header-links">
      {d.leetcodeUrl && (
        <a href={d.leetcodeUrl} target="_blank" rel="noopener noreferrer" class="link-btn lc-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/></svg>
          LeetCode Problem
        </a>
      )}
      {d.githubUrl && (
        <a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="link-btn gh-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          View Java Source
        </a>
      )}
    </div>

    <!-- Metadata row -->
    <div class="meta-grid">
      {(d.timeComplexity || d.spaceComplexity) && (
        <div class="meta-block">
          <span class="meta-label">Complexity</span>
          <div class="complexity-chips">
            {d.timeComplexity  && <span class="complexity-chip"><span class="cx-label">Time</span>{d.timeComplexity}</span>}
            {d.spaceComplexity && <span class="complexity-chip"><span class="cx-label">Space</span>{d.spaceComplexity}</span>}
          </div>
        </div>
      )}

      {d.patterns.length > 0 && (
        <div class="meta-block">
          <span class="meta-label">Patterns</span>
          <div class="tag-row">
            {d.patterns.map((p: string) => <span class="pattern-pill">{p}</span>)}
          </div>
        </div>
      )}

      {d.javaApis.length > 0 && (
        <div class="meta-block">
          <span class="meta-label">Java APIs</span>
          <div class="tag-row">
            {d.javaApis.map((api: string) => <span class="api-pill">{api}</span>)}
          </div>
        </div>
      )}
    </div>
  </header>

  <!-- MDX body -->
  <div class="prose-wrapper">
    <Content />
  </div>

  <!-- Back to topic -->
  <div class="back-link-row">
    <a href={`${base}/topics/${d.topic}`} class="back-link">
      ← All {topicLabel} problems
    </a>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--color-text-2);
    text-decoration: none;
    transition: color 0.1s;
  }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb span[aria-current] { color: var(--color-text); }

  /* ── Problem header ── */
  .problem-header {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .header-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .problem-title {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
    flex: 1;
  }
  .header-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.4rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
    background: var(--color-surface);
  }
  .link-btn:hover { border-color: var(--color-accent); background: var(--color-accent-bg); }
  .lc-btn { color: #f89f1b; }
  .gh-btn { color: var(--color-text-2); }

  /* ── Meta grid ── */
  .meta-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .meta-block { display: flex; align-items: flex-start; gap: 0.875rem; }
  .meta-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    min-width: 70px;
    margin-top: 0.3rem;
  }
  .complexity-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .complexity-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .cx-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .tag-row { display: flex; gap: 0.375rem; flex-wrap: wrap; }
  .pattern-pill {
    font-size: 0.75rem;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    background: var(--color-accent-bg);
    color: var(--color-accent);
    font-weight: 500;
  }
  .api-pill {
    font-size: 0.6875rem;
    font-family: 'JetBrains Mono', monospace;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-2);
  }

  /* ── Prose ── */
  .prose-wrapper {
    line-height: 1.75;
    color: var(--color-text);
    font-size: 0.9375rem;
  }
  .prose-wrapper :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 2rem 0 0.875rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-wrapper :global(h3), .prose-wrapper :global(h4) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 1.25rem 0 0.5rem;
  }
  .prose-wrapper :global(p) { margin: 0.75rem 0; color: var(--color-text-2); }
  .prose-wrapper :global(strong) { color: var(--color-text); }
  .prose-wrapper :global(ol), .prose-wrapper :global(ul) {
    padding-left: 1.5rem;
    color: var(--color-text-2);
    margin: 0.5rem 0;
  }
  .prose-wrapper :global(li) { margin: 0.25rem 0; }
  .prose-wrapper :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.75rem 1rem;
    background: var(--color-accent-bg);
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 1rem 0;
    color: var(--color-text-2);
    font-size: 0.9rem;
  }
  .prose-wrapper :global(pre) {
    border-radius: 0.625rem;
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .prose-wrapper :global(code:not(pre > code)) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1em 0.35em;
    font-size: 0.875em;
  }

  /* ── Back link ── */
  .back-link-row {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .back-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .back-link:hover { text-decoration: underline; }
</style>
