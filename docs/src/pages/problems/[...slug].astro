---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

export async function getStaticPaths() {
  const problems = await getCollection('problems');

  const byTopic: Record<string, typeof problems> = {};
  for (const p of problems) {
    const t = p.data.topic;
    if (!byTopic[t]) byTopic[t] = [];
    byTopic[t].push(p);
  }
  for (const topic in byTopic) {
    byTopic[topic].sort((a, b) => a.data.title.localeCompare(b.data.title));
  }

  return problems.map(entry => {
    const group = byTopic[entry.data.topic];
    const idx = group.findIndex(p => p.slug === entry.slug);
    const prev = idx > 0
      ? { title: group[idx - 1].data.title, slug: group[idx - 1].slug }
      : null;
    const next = idx < group.length - 1
      ? { title: group[idx + 1].data.title, slug: group[idx + 1].slug }
      : null;
    return {
      params: { slug: entry.slug },
      props: { entry, prev, next },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const base       = import.meta.env.BASE_URL.replace(/\/$/, '');
const topicLabel = d.topic.replace(/_/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const diffVar    = d.difficulty.toLowerCase() as 'easy' | 'medium' | 'hard';
---

<BaseLayout
  title={d.title}
  description={`${d.difficulty} ${topicLabel} problem — Java solution with complexity analysis and pattern breakdown.`}
  fullWidth={true}
>
  <Header slot="header" />

  <div class="problem-layout">

    <!-- ── Left metadata panel ── -->
    <aside class="meta-panel">
      <a href={`${base}/topics/${d.topic}`} class="back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
        {topicLabel}
      </a>

      <div class="meta-section">
        <span class="meta-label">DIFFICULTY</span>
        <span class={`diff-badge diff-${diffVar}`}>{d.difficulty}</span>
      </div>

      {d.javaApis.length > 0 && (
        <div class="meta-section">
          <span class="meta-label">JAVA APIS</span>
          <div class="pill-list">
            {d.javaApis.map((api: string) => <span class="api-pill">{api}</span>)}
          </div>
        </div>
      )}

      {d.patterns.length > 0 && (
        <div class="meta-section">
          <span class="meta-label">PATTERNS</span>
          <div class="pill-list">
            {d.patterns.map((p: string) => <span class="pattern-pill">{p}</span>)}
          </div>
        </div>
      )}

      {(d.timeComplexity || d.spaceComplexity) && (
        <div class="meta-section">
          <span class="meta-label">COMPLEXITY</span>
          {d.timeComplexity  && (
            <div class="cx-row">
              <span class="cx-label">TIME</span>
              <code class="cx-val">{d.timeComplexity}</code>
            </div>
          )}
          {d.spaceComplexity && (
            <div class="cx-row">
              <span class="cx-label">SPACE</span>
              <code class="cx-val">{d.spaceComplexity}</code>
            </div>
          )}
        </div>
      )}

      <div class="meta-section">
        <span class="meta-label">LINKS</span>
        {d.leetcodeUrl && (
          <a href={d.leetcodeUrl} target="_blank" rel="noopener noreferrer" class="ext-link">
            LeetCode ↗
          </a>
        )}
        {d.githubUrl && (
          <a href={d.githubUrl} target="_blank" rel="noopener noreferrer" class="ext-link">
            GitHub Source ↗
          </a>
        )}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <div class="problem-content">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a>
        <span aria-hidden="true">›</span>
        <a href={`${base}/topics/${d.topic}`}>{topicLabel}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{d.title}</span>
      </nav>

      <h1 class="problem-title">{d.title}</h1>

      <div class="prose-wrapper">
        <Content />
      </div>

      <!-- Prev/Next navigation -->
      <nav class="problem-nav">
        {prev ? (
          <a href={`${base}/problems/${prev.slug}`} class="nav-btn nav-prev">
            <span class="nav-label">← PREVIOUS</span>
            <span class="nav-title">{prev.title}</span>
          </a>
        ) : <div class="nav-placeholder" />}
        <span class="nav-topic">{topicLabel}</span>
        {next ? (
          <a href={`${base}/problems/${next.slug}`} class="nav-btn nav-next">
            <span class="nav-label">NEXT →</span>
            <span class="nav-title">{next.title}</span>
          </a>
        ) : <div class="nav-placeholder" />}
      </nav>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Two-column layout ── */
  .problem-layout {
    display: flex;
    gap: 0;
    min-height: calc(100vh - var(--header-height));
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
  }

  /* ── Left metadata panel ── */
  .meta-panel {
    width: 220px;
    flex-shrink: 0;
    padding: 2rem 1.25rem 2rem 1.5rem;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-2);
    text-decoration: none;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.12s, color 0.12s;
    width: fit-content;
  }
  .back-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .meta-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .meta-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .diff-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.3rem 0.875rem;
    border-radius: 0.375rem;
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .diff-easy   { color: var(--color-easy);   background: var(--color-easy-bg);   }
  .diff-medium { color: var(--color-medium); background: var(--color-medium-bg); }
  .diff-hard   { color: var(--color-hard);   background: var(--color-hard-bg);   }

  .pill-list { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .pattern-pill {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    background: var(--color-accent-bg);
    color: var(--color-accent-h);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  }
  .api-pill {
    font-size: 0.6875rem;
    font-family: 'JetBrains Mono', monospace;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-2);
  }

  .cx-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cx-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    min-width: 36px;
  }
  .cx-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    color: var(--color-accent-h);
    background: var(--color-accent-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
  }

  .ext-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.12s;
  }
  .ext-link:hover { color: var(--color-accent-h); text-decoration: underline; }

  /* ── Main content ── */
  .problem-content {
    flex: 1;
    min-width: 0;
    padding: 2rem 2.5rem 4rem;
    max-width: 760px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--color-text-2); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb span[aria-current] { color: var(--color-text); }

  .problem-title {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 2rem;
  }

  /* ── Prose ── */
  .prose-wrapper {
    line-height: 1.75;
    color: var(--color-text);
    font-size: 0.9375rem;
  }
  .prose-wrapper :global(h2) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 2rem 0 0.875rem;
    letter-spacing: -0.01em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-wrapper :global(h3), .prose-wrapper :global(h4) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 1.25rem 0 0.5rem;
  }
  .prose-wrapper :global(p) { margin: 0.75rem 0; color: var(--color-text-2); }
  .prose-wrapper :global(strong) { color: var(--color-text); font-weight: 600; }
  .prose-wrapper :global(em) { color: var(--color-text-2); }
  .prose-wrapper :global(ol), .prose-wrapper :global(ul) {
    padding-left: 1.5rem;
    color: var(--color-text-2);
    margin: 0.5rem 0;
  }
  .prose-wrapper :global(li) { margin: 0.3rem 0; }
  .prose-wrapper :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.75rem 1rem;
    background: var(--color-accent-bg);
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 1rem 0;
    color: var(--color-text-2);
    font-size: 0.9rem;
  }
  .prose-wrapper :global(pre) {
    border-radius: 0.625rem;
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .prose-wrapper :global(code:not(pre > code)) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1em 0.4em;
    font-size: 0.875em;
    color: var(--color-accent-h);
    font-family: 'JetBrains Mono', monospace;
  }
  .prose-wrapper :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 1rem 0;
  }
  .prose-wrapper :global(th) {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }
  .prose-wrapper :global(td) {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
  }

  /* ── Prev/Next navigation ── */
  .problem-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .nav-btn {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1.125rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    max-width: 210px;
    min-width: 120px;
    transition: border-color 0.12s, background 0.12s;
  }
  .nav-btn:hover { border-color: var(--color-accent); background: var(--color-accent-bg); }
  .nav-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .nav-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nav-next { text-align: right; }
  .nav-topic {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .nav-placeholder { min-width: 120px; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .problem-layout { flex-direction: column; }
    .meta-panel {
      width: 100%;
      height: auto;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 1.25rem 1.25rem;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }
    .meta-section { min-width: 120px; }
    .problem-content { padding: 1.5rem 1.25rem 3rem; }
    .problem-nav { flex-wrap: wrap; }
    .nav-btn { max-width: 100%; min-width: 0; flex: 1; }
    .nav-topic { width: 100%; text-align: center; order: -1; }
  }
</style>
