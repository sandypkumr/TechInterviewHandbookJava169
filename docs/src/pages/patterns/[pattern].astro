---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import ProblemCard from '../../components/ui/ProblemCard.astro';
import { PATTERNS, PATTERN_MAP } from '../../data/patterns';

export async function getStaticPaths() {
  const allProblems = await getCollection('problems');
  const patternSlugs = PATTERNS.map(p => p.slug);

  return patternSlugs.map(slug => ({
    params: { pattern: slug },
    props: {
      problems: allProblems
        .filter(p => p.data.patterns.includes(slug))
        .sort((a, b) => {
          const order = { Easy: 0, Medium: 1, Hard: 2 };
          const d = order[a.data.difficulty] - order[b.data.difficulty];
          return d !== 0 ? d : a.data.title.localeCompare(b.data.title);
        }),
    },
  }));
}

const { pattern }  = Astro.params;
const { problems } = Astro.props;
const meta         = PATTERN_MAP[pattern];
const base         = import.meta.env.BASE_URL.replace(/\/$/, '');

const easyCnt  = problems.filter(p => p.data.difficulty === 'Easy').length;
const medCnt   = problems.filter(p => p.data.difficulty === 'Medium').length;
const hardCnt  = problems.filter(p => p.data.difficulty === 'Hard').length;

// Group by topic for the secondary view
const byTopic: Record<string, typeof problems> = {};
for (const p of problems) {
  if (!byTopic[p.data.topic]) byTopic[p.data.topic] = [];
  byTopic[p.data.topic].push(p);
}
---

<BaseLayout
  title={`${meta?.name ?? pattern} Pattern`}
  description={meta?.description ?? `Problems using the ${pattern} pattern.`}
>
  <Sidebar slot="sidebar" />
  <Header  slot="header"  />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}/`}>Home</a>
    <span>›</span>
    <a href={`${base}/patterns`}>Patterns</a>
    <span>›</span>
    <span aria-current="page">{meta?.name ?? pattern}</span>
  </nav>

  <!-- Pattern header -->
  <header class="pattern-header">
    <div class="ph-icon" aria-hidden="true">{meta?.icon ?? '🧩'}</div>
    <div class="ph-body">
      <h1 class="ph-title">{meta?.name ?? pattern}</h1>
      {meta && <p class="ph-desc">{meta.description}</p>}
    </div>
  </header>

  <!-- Key idea box -->
  {meta && (
    <div class="key-idea">
      <span class="ki-label">Key Idea</span>
      <span class="ki-text">{meta.keyIdea}</span>
    </div>
  )}

  <!-- When to use -->
  {meta && meta.whenToUse.length > 0 && (
    <div class="when-to-use">
      <h3 class="wtu-title">When to use this pattern</h3>
      <ul class="wtu-list">
        {meta.whenToUse.map(hint => <li>{hint}</li>)}
      </ul>
      {meta.timeHint && (
        <span class="time-hint">Typical complexity: <code>{meta.timeHint}</code></span>
      )}
    </div>
  )}

  <!-- Stats row -->
  <div class="stat-row">
    <span class="stat-total">{problems.length} problem{problems.length !== 1 ? 's' : ''}</span>
    {easyCnt > 0 && <span class="diff-pill easy">{easyCnt} Easy</span>}
    {medCnt  > 0 && <span class="diff-pill medium">{medCnt} Medium</span>}
    {hardCnt > 0 && <span class="diff-pill hard">{hardCnt} Hard</span>}
  </div>

  <!-- Problem grid -->
  {problems.length === 0 ? (
    <p class="empty-msg">No tagged problems found for this pattern yet.</p>
  ) : (
    <div class="problem-grid">
      {problems.map(entry => (
        <ProblemCard
          title={entry.data.title}
          difficulty={entry.data.difficulty}
          topic={entry.data.topic}
          slug={entry.slug}
          patterns={entry.data.patterns}
          timeComplexity={entry.data.timeComplexity}
          spaceComplexity={entry.data.spaceComplexity}
          leetcodeUrl={entry.data.leetcodeUrl}
          githubUrl={entry.data.githubUrl}
        />
      ))}
    </div>
  )}

  <!-- Back link -->
  <div class="back-row">
    <a href={`${base}/patterns`} class="back-link">← All Patterns</a>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .breadcrumb {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; color: var(--color-text-muted);
    margin-bottom: 1.75rem; flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--color-text-2); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb span[aria-current] { color: var(--color-text); }

  .pattern-header {
    display: flex; align-items: flex-start; gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .ph-icon { font-size: 2.25rem; line-height: 1; flex-shrink: 0; margin-top: 0.125rem; }
  .ph-title {
    font-size: clamp(1.375rem, 3vw, 1.875rem); font-weight: 700;
    color: var(--color-text); letter-spacing: -0.025em; margin: 0 0 0.375rem;
  }
  .ph-desc { font-size: 0.9375rem; color: var(--color-text-2); margin: 0; line-height: 1.6; }

  .key-idea {
    display: flex; align-items: flex-start; gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--color-accent-bg);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
    margin-bottom: 1.25rem;
  }
  .ki-label {
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--color-accent);
    white-space: nowrap; margin-top: 0.15rem;
  }
  .ki-text { font-size: 0.875rem; color: var(--color-text); line-height: 1.6; }

  .when-to-use {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 0.625rem; padding: 1rem 1.125rem;
    margin-bottom: 1.5rem;
  }
  .wtu-title { font-size: 0.8125rem; font-weight: 700; color: var(--color-text-2); margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.07em; }
  .wtu-list { margin: 0 0 0.75rem; padding-left: 1.25rem; }
  .wtu-list li { font-size: 0.875rem; color: var(--color-text-2); margin: 0.25rem 0; }
  .time-hint { font-size: 0.8125rem; color: var(--color-text-muted); }
  .time-hint code { font-size: 0.8125rem; font-family: 'JetBrains Mono', monospace; color: var(--color-accent); }

  .stat-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .stat-total { font-size: 0.875rem; color: var(--color-text-muted); }
  .diff-pill { font-size: 0.6875rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 9999px; }
  .diff-pill.easy   { color: var(--color-easy);   background: var(--color-easy-bg); }
  .diff-pill.medium { color: var(--color-medium); background: var(--color-medium-bg); }
  .diff-pill.hard   { color: var(--color-hard);   background: var(--color-hard-bg); }

  .problem-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0.75rem; }
  .empty-msg { font-size: 0.9375rem; color: var(--color-text-muted); margin-top: 2rem; }

  .back-row { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .back-link { font-size: 0.875rem; color: var(--color-accent); text-decoration: none; font-weight: 500; }
  .back-link:hover { text-decoration: underline; }

  @media (max-width: 640px) { .problem-grid { grid-template-columns: 1fr; } }
</style>
